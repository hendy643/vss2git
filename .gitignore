# Dot-folders: ignore all except already tracked ones
.*/
!.github/
!.vscode/
*.csproj.user
bin/
obj/
Vss2GitSetup*.exe
*.scc
.idea/

# TestDbBuilder output (VSS test databases are created on-the-fly)
Vss2Git.IntegrationTests/TestData/

# Flatpak build output (generated by CI/build.sh, not checked in)
flatpak/publish-gui/
flatpak/publish-cli/
flatpak/build/
flatpak/repo/
flatpak/*.png
release/
*.flatpak
